<odoo>
    <record id='clinic_management_category' model='ir.module.category'>
        <field name='name'>Clinic Management</field>
    </record>

    <!-- Odoo 19: groups are grouped under a res.groups.privilege, which
         carries the ir.module.category (replaces res.groups.category_id). -->
    <record id='clinic_management_privilege' model='res.groups.privilege'>
        <field name='name'>Clinic Management</field>
        <field name='category_id' ref='clinic_management.clinic_management_category'/>
    </record>

    <record id='clinic_receptionist_group' model='res.groups'>
        <field name='name'>Clinic Receptionist Group</field>
        <field name='privilege_id' ref='clinic_management.clinic_management_privilege' />

    </record>

    <record id='clinic_admin_group' model='res.groups'>
        <field name='name'>Clinic Admin Group</field>
        <field name='privilege_id' ref='clinic_management.clinic_management_privilege' />

    </record>

    <record id='clinic_doctor_group' model='res.groups'>
        <field name='name'>Clinic Doctor Group</field>
        <field name='privilege_id' ref='clinic_management.clinic_management_privilege'/>
    </record>

    <record id='clinic_accountant_group' model='res.groups'>
        <field name='name'>Clinic Accountant Group</field>
        <field name='privilege_id' ref='clinic_management.clinic_management_privilege'/>
    </record>

    <record id='clinic_doctor_appointment_rule' model='ir.rule'>
        <field name='name'>linic.doctor.appointment.rule</field>
        <field name='model_id' ref='clinic_management.model_clinic_appointment'/>
        <field name="groups" eval="[(4, ref('clinic_management.clinic_doctor_group'))]"/>
        <field name='domain_force'>[('doctor_id.user_id','=',user.id)]</field>
        <field name='perm_read' eval='True'/>
        <field name='perm_write' eval='True'/>
        <field name='perm_create' eval='False'/>
        <field name='perm_unlink' eval='False'/>
    </record>

    <record id='clinic_doctor_visit_rule' model='ir.rule'>
        <field name='name'>linic.doctor.visit.rule</field>
        <field name='model_id' ref='clinic_management.model_clinic_visit'/>
        <field name="groups" eval="[(4, ref('clinic_management.clinic_doctor_group'))]"/>
        <field name='domain_force'>[('doctor_id.user_id','=',user.id)]</field>
        <field name='perm_read' eval='True'/>
        <field name='perm_write' eval='True'/>
        <field name='perm_create' eval='False'/>
        <field name='perm_unlink' eval='False'/>
    </record>

</odoo>