<odoo>


    <record id='create_follow_up_wizard' model='ir.ui.view'>
        <field name='name'>Create Follow Up Wizard</field>
        <field name='model'>create.followup</field>
        <field name='arch' type='xml'>
        <form>
            <group>
                <field name='appointment_id'/>
                <field name='appointment_date'/>
                <field name='appointment_hour'/>
            </group>
            <footer>
                <button string='Confirm' type='object' name='create_follow_up_appointment' class='btn-primary'/>
                <button string='Cancel' special='cancel' class='btn-secondary'/>
            </footer>
        </form>
        </field>
    </record>

    <record id='action_create_follow_up_wizard' model='ir.actions.act_window'>
        <field name='name'>Create Follow Up Wizard Action</field>
        <field name='res_model'>create.followup</field>
        <field name='target'>new</field>
        <field name='view_mode'>form</field>
    </record>

</odoo>