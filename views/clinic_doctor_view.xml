<odoo>

    <record id='clinic_doctor_list_view' model='ir.ui.view'>
        <field name='name'>Doctor List View</field>
        <field name='model'>clinic.doctor</field>
        <field name='arch' type='xml'>
            <tree>
                <field name='ref' />
                <field name='name' />
                <field name='specialization' />
                <field name='phone' />
            </tree>
        </field>
    </record>

    <record id='clinic_doctor_search_view' model='ir.ui.view'>
        <field name='name'>Doctor Search View</field>
        <field name='model'>clinic.doctor</field>
        <field name='arch' type='xml'>
            <search>
                <field name='ref' />
                <field name='name' />

                <filter name='group_by' string='Group by Specialization'
                    context='{"group_by" : "specialization"}' />

            </search>
        </field>
    </record>

    <record id='clinic_doctor_form_view' model='ir.ui.view'>
        <field name='name'> Doctor Form View</field>
        <field name='model'>clinic.doctor</field>
        <field name='arch' type='xml'>
            <form>
                <sheet>
                    <field name='appointment_ids' invisible='1' />
                    <div name="button_box" class="oe_button_box">

                        <button
                            name="open_related_appointment_button"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                            invisible="not appointment_ids">

                            <field
                                name="appointment_count"
                                widget="statinfo"
                                string="Appointments" />

                        </button>
                    </div>
                    <label for='ref' />
                    <h1>
                        <field name='ref' />
                    </h1>
                    <label for='name' />
                    <h3>
                        <field name='name' placeholder='Ahmed Ali' />
                    </h3>

                    <group>
                        <group string='General Info'>
                            <field name='phone' placeholder='05493828' />
                            <field name='email' placeholder='ahmed@example.com' />
                        </group>
                        <group string='Medical Employee Info'>
                            <field name='specialization' placeholder='Dentist' />
                            <field name='license_no' placeholder='12345678' />
                        </group>
                        <field name='active' invisible='1' />
                    </group>
                </sheet>
                <div class='oe_chatter'>
                    <field name='message_follower_ids' />
                    <field name='activity_ids' />
                    <field name='message_ids' />
                </div>
            </form>
        </field>
    </record>

    <record id="clinic_doctor_kanban_view" model="ir.ui.view">
        <field name="name">clinic.doctor.kanban.view</field>
        <field name="model">clinic.doctor</field>

        <field name="arch" type="xml">
            <kanban sample="1">

                <field name="name" />
                <field name="ref" />

                <templates>
                    <t t-name="kanban-box">

                        <div class="oe_kanban_global_click">

                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">

                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>

                                    <div class="text-muted mt-1"> Ref: <field name="ref" />
                                    </div>

                                </div>
                            </div>

                        </div>

                    </t>
                </templates>

            </kanban>
        </field>
    </record>


    <record id='action_clinic_doctor' model='ir.actions.act_window'>
        <field name='name'>Doctors</field>
        <field name='res_model'>clinic.doctor</field>
        <field name='view_mode'>kanban,tree,form</field>
    </record>

    <menuitem
        id='clinic_doctor_menu'
        name='Doctors'
        parent='clinic_root_menu'
        action='action_clinic_doctor'
    />
</odoo>