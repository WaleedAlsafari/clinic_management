<odoo>
    <record id='clinic_prescription_report_action' model='ir.actions.report'>
        <field name='name'>Clinic Prescription Reprot Action</field>
        <field name='model'>clinic.visit</field>
        <field name='report_type'>qweb-html</field>
        <field name='binding_model_id' ref='model_clinic_visit' />
        <field name='binding_type'>report</field>
        <field name='report_name'>clinic_management.prescription_report_template</field>
    </record>

    <template id='prescription_report_template'>
        <t t-call='web.html_container'>
            <t t-call='web.basic_layout'>
                <t t-foreach='docs' t-as='rec'>
                    <div class='page'>
                        <h2>Prescription Report</h2>
                        <div>
                            <table style="width:100%;  border:1px solid #999;" >
    <tr>
        <td style="background:#d9d9d9; font-weight:bold; padding:6px;">Patient Name</td>
        <td style="padding:6px;"><span t-field="rec.patient_id.name"/></td>

        <td style="background:#d9d9d9; font-weight:bold; padding:6px;">File No</td>
        <td style="padding:6px; "><span t-field="rec.patient_id.ref"/></td>

        <td style="background:#d9d9d9; font-weight:bold; padding:6px;">National ID</td>
        <td style="padding:6px;"><span t-field="rec.patient_id.nid"/></td>
    </tr>
</table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>