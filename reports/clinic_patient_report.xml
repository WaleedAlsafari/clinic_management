<odoo>
<record id="action_patient_report" model="ir.actions.report">
    <field name="name">Patient File</field>
    <field name="model">clinic.patient</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">clinic_management.patient_report_template</field>
    <field name="report_file">clinic_management.patient_report_template</field>
    <field name="binding_model_id" ref="model_clinic_patient"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">
        (object.ref or 'Patient File')
    </field>
   
</record>


<template id="patient_report_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="patient">
            <t t-call="web.external_layout">

                <div class="page">

                    <div class="mb-4">
                        <h5>Patient File</h5>
                        <hr/>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6">
                            <strong>File No</strong><br/>
                            <span t-field="patient.ref"/>
                        </div>

                        <div class="col-6">
                            <strong>Name</strong><br/>
                            <span t-field="patient.name"/>
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-6">
                            <h6>
                                <strong>GENERAL INFO</strong>
                            </h6>
                            <hr/>

                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td><strong>Phone</strong></td>
                                    <td>
                                        <span t-field="patient.phone"/>
                                    </td>
                                </tr>


                                <tr>
                                    <td><strong>Gender</strong></td>
                                    <td>
                                        <span t-field="patient.gender"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Date of Birth</strong></td>
                                    <td>
                                        <span t-field="patient.date_of_birth"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Blood Group</strong></td>
                                    <td>
                                        <span t-field="patient.blood_type"/>
                                    </td>
                                </tr>
                            </table>

                        </div>

               
                        <div class="col-6">
                            <h6>
                                <strong>MEDICAL INFO</strong>
                            </h6>
                            <hr/>

                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td><strong>Height</strong></td>
                                    <td>
                                        <span t-field="patient.hight"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Weight</strong></td>
                                    <td>
                                        <span t-field="patient.weight"/>
                                    </td>
                                </tr>


                            </table>

                        </div>

                    </div>

                </div>

            </t>
        </t>
    </t>
</template>
</odoo>