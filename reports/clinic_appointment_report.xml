<odoo>
    <record id="appointment_report_action" model="ir.actions.report">
    <field name="name">Appointment Details</field>
    <field name="model">clinic.appointment</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">clinic_management.appointment_report_template</field>
    <field name="binding_model_id" ref="model_clinic_appointment"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">
        ('Appointment Report - %s' % object.appointment_no)
    </field>
</record>

<template id="appointment_report_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="appointment">
            <t t-call="web.external_layout">

                <div class="page">

                    <h2 style="margin-bottom:20px;">
                        Appointment Details
                    </h2>

                    <table class="table table-bordered">
                        <tbody>

                            <tr>
                                <th width="30%">Appointment Number</th>
                                <td>
                                    <span t-field="appointment.appointment_no"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Patient</th>
                                <td>
                                    <span t-field="appointment.patient_id"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Doctor</th>
                                <td>
                                    <span t-field="appointment.doctor_id"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Appointment Date</th>
                                <td>
                                    <span t-field="appointment.appointment_date"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Appointment Time</th>
                                <td>
                                    <span t-field="appointment.appointment_hour"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Reason</th>
                                <td>
                                    <span t-field="appointment.reason"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Notes</th>
                                <td>
                                    <span t-field="appointment.notes"/>
                                </td>
                            </tr>

                            <tr>
                                <th>Follow Up</th>
                                <td>
                                    <t t-if="appointment.is_follow_up">
                                        Yes
                                    </t>
                                    <t t-else="">
                                        No
                                    </t>
                                </td>
                            </tr>

                        </tbody>
                    </table>

                </div>

            </t>
        </t>
    </t>
</template>
</odoo>