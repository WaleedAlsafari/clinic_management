<odoo>
<record id="action_doctor_report" model="ir.actions.report">
    <field name="name">Doctor File</field>
    <field name="model">clinic.doctor</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">clinic_management.doctor_report_template</field>
    <field name="report_file">clinic_management.doctor_report_template</field>
    <field name="binding_model_id" ref="model_clinic_doctor"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">
        (object.ref or 'Doctor File')
    </field>
</record>


<template id="doctor_report_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doctor">
            <t t-call="web.external_layout">

                <div class="page">

                    <div class="mb-4">
                        <h5>Doctor File</h5>
                        <hr/>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6">
                            <strong>Reference</strong><br/>
                            <span t-field="doctor.ref"/>
                        </div>

                        <div class="col-6">
                            <strong>Name</strong><br/>
                            <span t-field="doctor.name"/>
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-6">
                            <h6>
                                <strong>GENERAL INFO</strong>
                            </h6>
                            <hr/>

                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td><strong>Phone</strong></td>
                                    <td>
                                        <span t-field="doctor.phone"/>
                                    </td>
                                </tr>

                                 <tr>
                                    <td><strong>Email</strong></td>
                                    <td>
                                        <span t-field="doctor.email"/>
                                    </td>
                                </tr>

                            </table>

                        </div>

               
                        <div class="col-6">
                            <h6>
                                <strong>MEDICAL EMPLOYEE INFO</strong>
                            </h6>
                            <hr/>

                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td><strong>Specialization</strong></td>
                                    <td>
                                        <span t-field="doctor.specialization"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>License Number</strong></td>
                                    <td>
                                        <span t-field="doctor.license_no"/>
                                    </td>
                                </tr>


                            </table>

                        </div>

                    </div>

                </div>

            </t>
        </t>
    </t>
</template>
</odoo>